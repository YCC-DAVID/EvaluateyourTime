# 复制为 .env 后填写。.env 不会进入 git，也不参与同步。
PORT=5180

# ---- AI 后端 ----
# api        : 直接调用 Claude API，需要 ANTHROPIC_API_KEY，按用量计费
# claude-cli : 使用本机已登录的 Claude Code（claude -p），用你的订阅额度
# codex-cli  : 使用本机已登录的 Codex（codex exec），用你的订阅额度
# 留空时：填了 ANTHROPIC_API_KEY 就用 api，否则用 claude-cli
AI_PROVIDER=

# ---- api 后端 ----
ANTHROPIC_API_KEY=
# 可选：自定义 API 地址（代理或兼容网关）。留空则用官方地址。
AI_BASE_URL=
AI_MODEL=claude-opus-5-5
# 服务端备用模型（模型拒答时自动换备用模型）；填 off 关闭
AI_FALLBACKS=

# ---- CLI 后端（都可留空）----
# 指定模型；留空用 CLI 自己的默认模型
CLAUDE_CLI_MODEL=
CODEX_MODEL=
# 命令不在 PATH 里时填写完整路径
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=
# 单次调用超时（毫秒）
AI_CLI_TIMEOUT_MS=180000

# ---- 可选：语音转写服务（OpenAI 兼容的 /audio/transcriptions 接口，例如 Whisper）----
# 不填时使用浏览器自带的语音识别。
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
