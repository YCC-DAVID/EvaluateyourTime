# 复制为 .env 后填写。.env 不会进入 git，也不参与同步。
PORT=5180

# ---- AI 评分服务（Anthropic API）----
ANTHROPIC_API_KEY=
# 可选：自定义 API 地址（代理或兼容网关）。留空则用官方地址。
AI_BASE_URL=
# 默认模型
AI_MODEL=claude-opus-5-5

# ---- 可选：语音转写服务（OpenAI 兼容的 /audio/transcriptions 接口，例如 Whisper）----
# 不填时使用浏览器自带的语音识别。
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
